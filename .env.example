# Copy to .env and fill in. NEVER commit .env (gitignored).

# --- network ---
# Spark hostname on the Tailscale mesh (cli/twin.py auto-loads .env if present)
TWIN_SPARK_HOST=spark-e9cb-2.local

# --- Hugging Face (private repos for corpus tarballs + adapters) ---
HF_TOKEN=
HF_CORPUS_REPO=abhi/twin-corpus        # private dataset repo
HF_PERSONA_REPO=abhi/persona-v1        # private adapter repo
HF_VOICE_REPO=abhi/voice-v1            # private checkpoint repo
HF_MUSETALK_REPO=abhi/musetalk-identity-v1

# --- cloud burst: Brev first, Vast fallback (spec §5) ---
BREV_API_KEY=
BREV_ORG=
VAST_API_KEY=

# --- corpus extraction (mac) ---
TWIN_ME_EMAIL=abhi@sequoiadigital.io   # owner address, used to select "sent by me"
TWIN_SLACK_ME=                         # Slack user id (e.g. U01234567)
TWIN_GITHUB_USER=abhione

# --- serving ports (Spark) ---
TWIN_LLM_PORT=8000
TWIN_TTS_PORT=8001
TWIN_TTS_STREAM_PORT=8002
TWIN_STT_PORT=8003
TWIN_VIDEO_PORT=8004
TWIN_ORCH_PORT=8080
QDRANT_PORT=6333
